{
  "name": "access-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Accessibility Atlas — Sustainable Cities team, Sony CSL Rome",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-compress.mjs",
    "build:nogzip": "vite build",
    "preview": "vite preview",
    "import": "node scripts/check-node.cjs h3-js && node scripts/import-data.mjs",
    "update:data": "node scripts/check-node.cjs h3-js && node scripts/update-data.mjs",
    "stats": "node scripts/check-node.cjs h3-js && node scripts/build-stats.mjs",
    "compress:dist": "node scripts/postbuild-compress.mjs",
    "test:data": "node scripts/check-node.cjs && node scripts/test-data.mjs",
    "shoot:previews": "node scripts/check-node.cjs && node scripts/shoot-previews.mjs",
    "smoke": "node scripts/check-node.cjs playwright && node scripts/smoke.mjs",
    "smoke:published": "node scripts/check-node.cjs playwright && node scripts/smoke-published.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
